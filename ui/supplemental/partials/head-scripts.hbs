{{#with site.keys.googleAnalytics}}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{this}}"></script>
    <script>function gtag(){dataLayer.push(arguments)};window.dataLayer=window.dataLayer||[];gtag('js',new Date());gtag('config','{{this}}')</script>
    {{/with}}
    {{!-- Legacy `go.php?to=<key>` redirector. ownCloud core still deep-links into
          the docs via /server/<version>/go.php?to=<key>, but the static GitHub
          Pages site has no PHP, so those URLs fall through to the custom 404
          page. This script runs in <head> on every page and is a no-op unless
          the path ends in `go.php`, in which case it redirects to the mapped
          page BEFORE the 404 body renders (no visible flash). See
          js/go-redirect.js. --}}
    <script src="{{{uiRootPath}}}/js/go-redirect.js"></script>
